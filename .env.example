# Example environment variables for OnePOS
# Copy to .env and fill values (do NOT commit secrets)

MONGO_URI="mongodb://127.0.0.1:27017/onepos"
PORT=5000
NODE_ENV=development

BILL_PRINTER_NAME="XP-80C"

# Notify.lk (SMS) - replace with your account values
NOTIFY_USER_ID=your_notify_user_id
NOTIFY_API_KEY=your_notify_api_key
NOTIFY_SENDER_ID=YourSenderID

# Bulk SMS campaign sending speed (optional). Leave commented out to use the
# defaults: 3 SMS at a time, 1 second between batches (~3 SMS/second).
# Raise only if Notify.lk confirms your account allows a higher rate.
# SMS_CONCURRENCY=3        # SMS sent at the same time per batch (max 10)
# SMS_BATCH_DELAY_MS=1000  # pause between batches, in milliseconds
