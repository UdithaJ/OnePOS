# Example environment variables for OnePOS
# Copy to .env and fill values (do NOT commit secrets)

MONGO_URI="mongodb://127.0.0.1:27017/onepos"
PORT=5000
NODE_ENV=development

# Notify.lk (SMS) - replace with your account values
NOTIFY_USER_ID=your_notify_user_id
NOTIFY_API_KEY=your_notify_api_key
NOTIFY_SENDER_ID=YourSenderID
