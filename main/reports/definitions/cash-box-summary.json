{
  "id": "cash-box-summary",
  "title": "Cash Box Summary (Cash Inflow)",
  "menuTitle": "Cash Box Summary",
  "group": "Reports",
  "icon": "mdi-cash-register",
  "permission": "admin",
  "order": 60,

  "exportTitle": "Cash Box Summary Report",
  "exportBasename": "cash-box-summary",
  "sheetName": "Cash Box Summary",
  "orientation": "landscape",
  "emptyMessage": "No cash payments found for the selected date range.",

  "params": [
    { "name": "fromDate", "type": "date", "label": "From Date", "default": "today", "required": true, "bind": "dayStart" },
    { "name": "toDate", "type": "date", "label": "To Date", "default": "today", "required": true, "bind": "dayEnd" },
    {
      "name": "dateBasis",
      "type": "select",
      "label": "Date Basis",
      "default": "transaction",
      "options": [
        { "label": "Transaction Date", "value": "transaction" },
        { "label": "Business Day", "value": "business" }
      ]
    }
  ],

  "source": { "model": "payment", "processor": "cash-box-summary" },

  "columns": [
    { "key": "orderNo", "label": "Order No", "type": "text", "pad": 4 },
    { "key": "createdDate", "label": "Order Created Date", "type": "date" },
    { "key": "paymentDate", "label": "Payment Date", "type": "date" },
    { "key": "customerName", "label": "Customer", "type": "text" },
    { "key": "totalAmount", "label": "Total Amount", "type": "number", "align": "right", "format": "grouped", "exportFormat": "fixed", "exportDecimals": 2 },
    { "key": "discount", "label": "Discount", "type": "number", "align": "right", "format": "grouped", "zeroAs": "-", "exportFormat": "fixed", "exportDecimals": 2 },
    { "key": "orderAmountAfterDiscount", "label": "Order Amount After Discount", "type": "number", "align": "right", "format": "grouped", "exportFormat": "fixed", "exportDecimals": 2 },
    { "key": "dueAmount", "label": "Due Amount", "type": "number", "align": "right", "format": "grouped", "zeroAs": "-", "exportFormat": "fixed", "exportDecimals": 2 },
    { "key": "paymentMethod", "label": "Payment Method", "type": "badge", "valueMap": "paymentMethod", "emptyAs": "-" },
    { "key": "paymentReceived", "label": "Payment Received", "type": "number", "align": "right", "format": "grouped", "emptyAs": "-", "exportFormat": "fixed", "exportDecimals": 2 }
  ],

  "footer": {
    "label": "Total Amount Received",
    "column": "paymentReceived",
    "fn": "sum",
    "of": "paymentReceived",
    "format": "grouped",
    "exportFormat": "fixed",
    "exportDecimals": 2
  }
}
